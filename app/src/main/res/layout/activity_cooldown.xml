<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cooldown_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/cooldown_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在解除锁定…"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cooldown_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/cooldown_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cooldown_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="请保持本页面停留在前台，切到其他应用将重新计时"
            android:textSize="13sp"
            android:gravity="center" />

        <Button
            android:id="@+id/cooldown_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="取消" />

    </LinearLayout>
</ScrollView>
